# Supabase
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Solana — use devnet for staging/Vercel cron; mainnet RPC + wallet in production
# 1. SOLANA_FEEDER_WALLET_SECRET = 64-byte keypair as bs58, OR solana-keygen JSON array [1,2,...]
#    Verify funded address: npm run solana:feeder  (must match solana airdrop target)
# 2. Fund on devnet: solana airdrop 2 <FEEDER_PUBKEY> --url devnet
# 3. Set same SOLANA_RPC_URL + SOLANA_FEEDER_WALLET_SECRET on Vercel, then redeploy
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_FEEDER_WALLET_SECRET=

# Cron — Authorization: Bearer header for /api/cron/* (GitHub Actions + manual curl)
# Vercel env: CRON_SECRET, SOLANA_RPC_URL, SOLANA_FEEDER_WALLET_SECRET (all three required for cron)
# GitHub repo secrets: CRON_SECRET, APP_URL=https://loadruk.vercel.app (no trailing slash)
# Reset failed receipts: UPDATE blockchain_receipts SET status='pending', retry_count=0 WHERE status='failed';
CRON_SECRET=

# Twilio (driver invite SMS — optional in dev; logs link when unset)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Google Maps / Places (address autocomplete — optional in dev)
GOOGLE_MAPS_API_KEY=
# Places backend: "new" (Places API New) or "legacy" (classic Places API). Use one only.
GOOGLE_PLACES_API=new
# Set to true in local dev to use built-in UK demo addresses and avoid Google quota entirely.
GOOGLE_PLACES_MOCK=false
