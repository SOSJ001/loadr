# Supabase
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Solana (use devnet RPC + funded feeder wallet in local dev; mainnet in production)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_FEEDER_WALLET_SECRET=

# Cron — Authorization: Bearer header for /api/cron/* (GitHub Actions + manual curl)
# Vercel env: CRON_SECRET (same value as GitHub), SOLANA_RPC_URL, SOLANA_FEEDER_WALLET_SECRET
# GitHub repo secrets: CRON_SECRET, APP_URL=https://loadruk.vercel.app (no trailing slash)
# Scheduled runs only execute from the default branch — merge this workflow to main.
CRON_SECRET=

# Twilio (driver invite SMS — optional in dev; logs link when unset)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Google Maps / Places (address autocomplete — optional in dev)
GOOGLE_MAPS_API_KEY=
# Places backend: "new" (Places API New) or "legacy" (classic Places API). Use one only.
GOOGLE_PLACES_API=new
# Set to true in local dev to use built-in UK demo addresses and avoid Google quota entirely.
GOOGLE_PLACES_MOCK=false
